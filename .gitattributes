# Normalize all text files to LF in the repository, regardless of the
# checkout platform. Stops the recurring CRLF churn on Windows/WSL checkouts.
* text=auto eol=lf

# Scripts must stay LF or their shebang breaks (`/usr/bin/env bash\r`).
*.sh text eol=lf

# Binary assets — never touched by line-ending normalization or diffed as text.
*.bin binary
*.nc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
